import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const utilsDir = path.join(__dirname, '..', 'src', 'utils');
const sourcePath = path.join(utilsDir, 'stationReportExport.js');
const lines = fs.readFileSync(sourcePath, 'utf8').split(/\r?\n/);
const slice = (from, to) => lines.slice(from - 1, to).join('\n');

fs.writeFileSync(path.join(utilsDir, 'stationReportPdfCore.js'), slice(1, 237));

fs.writeFileSync(
  path.join(utilsDir, 'stationReportMedia.js'),
  `import { drawSubheading, ensureSpace, pdfText } from './stationReportPdfCore';
import { formatDate } from './formatters';
import { getDocument } from 'pdfjs-dist';

${slice(239, 599)}
`
);

fs.writeFileSync(
  path.join(utilsDir, 'stationReportTables.js'),
  `import autoTable from 'jspdf-autotable';
import { formatDate } from './formatters';
import { dash, pdfText } from './stationReportPdfCore';

export ${slice(118, 127).replace(/^const /, 'const ')}

${slice(155, 219)
  .replace(/^function drawMaterialsTable/gm, 'export function drawMaterialsTable')
  .replace(/^function drawDailyReportsTable/gm, 'export function drawDailyReportsTable')}
`
);

fs.writeFileSync(
  path.join(utilsDir, 'stationReportRender.js'),
  `import autoTable from 'jspdf-autotable';
import { formatDate } from './formatters';
import { stationWorkDonePct } from './projectFlow';
import {
  dash,
  drawKeyValueTable,
  drawSectionTitle,
  drawSubheading,
  pdfCurrency,
  pdfText,
} from './stationReportPdfCore';
import { drawDailyReportMedia, drawPhotoSection, drawSingleAttachment } from './stationReportMedia';
import { drawDailyReportsTable, drawMaterialsTable, VALUE_STYLES } from './stationReportTables';

function contactLabel(contact) {
  if (!contact) return '-';
  const label = [contact.name, contact.number].filter(Boolean).join(' / ');
  return dash(label);
}

export async function renderStationSections(doc, project, station, startY) {
${slice(602, 753)}
}
`
);

fs.writeFileSync(
  path.join(utilsDir, 'stationReportBuild.js'),
  `import { jsPDF } from 'jspdf';
import { addFooter, drawHeader, pdfText, safeFilePart } from './stationReportPdfCore';
import { renderStationSections } from './stationReportRender';

${slice(756, 775)}

${slice(777, 811).replace(/^export /gm, 'export ')}
`
);

fs.writeFileSync(
  path.join(utilsDir, 'stationReportExport.js'),
  `export {
  pdfText,
  dash,
  pdfCurrency,
  safeFilePart,
  ensureSpace,
  drawHeader,
  drawSectionTitle,
  drawSubheading,
  drawKeyValueTable,
  addFooter,
} from './stationReportPdfCore';
export { downloadSingleStationReport, downloadStationWiseReport } from './stationReportBuild';
`
);

// --- BG application split ---
const bgLines = fs.readFileSync(path.join(utilsDir, 'bgApplicationExport.js'), 'utf8').split(/\r?\n/);
const bgSlice = (from, to) => bgLines.slice(from - 1, to).join('\n');

fs.writeFileSync(
  path.join(utilsDir, 'bgApplicationConstants.js'),
  `${bgSlice(1, 31)}
`
);

fs.writeFileSync(
  path.join(utilsDir, 'bgApplicationDraw.js'),
  `import { jsPDF } from 'jspdf';
import { formatDate } from './formatters';
import { pdfText, dash, pdfCurrency, ensureSpace, safeFilePart } from './stationReportExport';
import { HDFC_LOGO_BASE64 } from '../assets/hdfcLogoBase64';
import {
  BG_TYPE_OPTIONS,
  DECLARATION_ITEMS,
  DECLARATION_ITEMS_AFTER_CLAIM,
  HEADER_BLUE,
  LABEL_COLOR,
  VALUE_COLOR,
  BOX_LINE,
  SECTION_BORDER,
  MARGIN,
  COL_GAP,
  SECTION_GAP,
} from './bgApplicationConstants';

${bgSlice(33, 587)}
`
);

fs.writeFileSync(
  path.join(utilsDir, 'bgApplicationPdf.js'),
  `import { jsPDF } from 'jspdf';
import { formatDate } from './formatters';
import { pdfText, pdfCurrency, safeFilePart } from './stationReportExport';
import { BG_TYPE_OPTIONS, DECLARATION_ITEMS, DECLARATION_ITEMS_AFTER_CLAIM, MARGIN, COL_GAP, HEADER_BLUE, LABEL_COLOR, VALUE_COLOR, BOX_LINE } from './bgApplicationConstants';
import {
  cols,
  versionFooter,
  drawFormHeader,
  drawBoxedSection,
  drawPage2BankDetailsBox,
  drawMarginDetailsBox,
  drawDeclarationList,
  measureDeclarationList,
  drawCheckbox,
  drawInlineSegmentedBoxes,
  drawLabeledConnectedBoxes,
  drawCheckboxOption,
  drawStackedBox,
  drawInlineBox,
  drawNatureGrid,
  drawEvenCheckboxRow,
  drawLeftLabelBox,
  drawSharedLabelBoxes,
  drawInlineDateBoxes,
  drawBgTenor,
} from './bgApplicationDraw';

${bgSlice(589, 963)}
`
);

// export draw helpers from bgApplicationDraw.js
const drawContent = fs.readFileSync(path.join(utilsDir, 'bgApplicationDraw.js'), 'utf8');
const exportNames = [
  'cols',
  'versionFooter',
  'drawFormHeader',
  'drawBoxedSection',
  'drawPage2BankDetailsBox',
  'drawMarginDetailsBox',
  'drawParagraphs',
  'measureDeclarationList',
  'drawDeclarationList',
  'wrapFieldLines',
  'stackedBoxHeight',
  'drawStackedBox',
  'drawInlineBox',
  'drawSegmentedBoxes',
  'drawDateBoxes',
  'drawCheckboxGroup',
  'drawCheckbox',
  'drawNatureGrid',
  'drawBgTenor',
  'drawCheckboxOption',
  'drawInlineSegmentedBoxes',
  'drawLeftLabelBox',
  'drawEvenCheckboxRow',
  'drawSharedLabelBoxes',
  'drawInlineDateBoxes',
  'drawLabeledConnectedBoxes',
];
let mutated = drawContent;
exportNames.forEach((name) => {
  mutated = mutated.replace(new RegExp(`^function ${name}\\(`, 'm'), `export function ${name}(`);
});
fs.writeFileSync(path.join(utilsDir, 'bgApplicationDraw.js'), mutated);

// export constants
const constContent = fs.readFileSync(path.join(utilsDir, 'bgApplicationConstants.js'), 'utf8');
fs.writeFileSync(
  path.join(utilsDir, 'bgApplicationConstants.js'),
  constContent
    .replace(/^const BG_TYPE_OPTIONS/gm, 'export const BG_TYPE_OPTIONS')
    .replace(/^const MARGIN/gm, 'export const MARGIN')
    .replace(/^const COL_GAP/gm, 'export const COL_GAP')
    .replace(/^const SECTION_GAP/gm, 'export const SECTION_GAP')
    .replace(/^const HEADER_BLUE/gm, 'export const HEADER_BLUE')
    .replace(/^const LABEL_COLOR/gm, 'export const LABEL_COLOR')
    .replace(/^const VALUE_COLOR/gm, 'export const VALUE_COLOR')
    .replace(/^const BOX_LINE/gm, 'export const BOX_LINE')
    .replace(/^const SECTION_BORDER/gm, 'export const SECTION_BORDER')
    .replace(/^const DECLARATION_ITEMS = \[/m, 'export const DECLARATION_ITEMS = [')
    .replace(/^const DECLARATION_ITEMS_AFTER_CLAIM = \[/m, 'export const DECLARATION_ITEMS_AFTER_CLAIM = [')
);

fs.writeFileSync(
  path.join(utilsDir, 'bgApplicationExport.js'),
  `export { downloadBgApplicationPdf } from './bgApplicationPdf';
`
);

console.log('split complete');