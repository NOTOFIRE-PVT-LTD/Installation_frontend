VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME=Valuecon Workspace
# Portal login + /apps live in this app (Installation_frontend)
# Optional: P&L logout hop when clearing a leftover P&L cookie
VITE_PNL_PUBLIC_URL=http://localhost:3000
# Companion apps (Desktop siblings)
VITE_SHIPPING_APP_URL=http://localhost:3002
VITE_IMPORT_APP_URL=http://localhost:3003

# EC2 path deploy: build with VITE_BASE_PATH=/ (portal at /) or /ws/ if nested
# VITE_BASE_PATH=/

# Production example:
# VITE_API_BASE_URL=https://your.host/ws-api
# VITE_PNL_PUBLIC_URL=https://your.host/pnl
